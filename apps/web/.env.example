# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://woodex.interior
NEXT_PUBLIC_WHATSAPP_NUMBER=923224000768
# Booking tool link (Cal.com / Calendly). When empty, /consultation shows the
# brief-form + WhatsApp fallback instead of the inline scheduler.
NEXT_PUBLIC_CAL_LINK=

# ── Lead delivery ────────────────────────────────────────────────────────────
# Email via Resend. All three must be set to enable email delivery.
RESEND_API_KEY=
RESEND_FROM=Woodex Interior <studio@woodex.interior>
RESEND_TO=studio@woodex.interior
# Generic JSON webhook (HubSpot/Zoho/Pipedrive). POST {formType, submittedAt, ...fields}.
CRM_WEBHOOK_URL=

# ── Sanity ───────────────────────────────────────────────────────────────────
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=

# ── Analytics ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_ID=

# ── Infra ────────────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SENTRY_DSN=
